{
  "name": "briefs-todo-app-starter",
  "version": "0.1.0",
  "description": "To-Do application with FastAPI, SvelteKit, and Tailwind CSS v4",
  "type": "module",
  "author": "Maxime Lenne",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "bun@1.1.45",
  "scripts": {
    "lint": "bun run lint:md && bun run lint:yaml && bun run lint:commit",
    "lint:md": "markdownlint **/*.md",
    "lint:md:fix": "markdownlint **/*.md --fix",
    "lint:yaml": "bunx yaml-lint '**/*.{yml,yaml}'",
    "lint:commit": "commitlint --last",
    "commit": "gitmoji-cli",
    "secrets:scan": "bun run scripts/secrets-scan.js",
    "pre-commit-hook": "bun run scripts/pre-commit-hook.js",
    "pre-push-hook": "bun run scripts/pre-push-hook.js",
    "commit-msg-hook": "bun run scripts/commit-msg-hook.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:exec:api": "docker compose exec api bash",
    "docker:exec:web": "docker compose exec web bash",
    "docker:test": "docker compose up -d --wait && sleep 10 && docker compose logs",
    "test": "bun run test:api && bun run test:web",
    "test:api": "cd api && uv run pytest tests/ -v",
    "test:web": "cd web && bun run test",
    "test:e2e": "cd e2e && bun run test",
    "test:all": "bun run test:api && bun run test:web && bun run test:e2e",
    "check": "cd web && bun run check",
    "check:all": "cd api && uv run ruff check . && cd web && bun run check"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "gitmoji-cli": "^9.1.0",
    "markdownlint-cli": "^0.48.0",
    "yaml-lint": "^1.7.0"
  },
  "dependencies": {
    "cucumber-expressions": "^8.3.0"
  }
}
